# Node.js version (used as build ARG in Docker — applies to both backend and frontend)
NODE_VERSION=22

# Database (MySQL)
# DB_HOST: use "localhost" for local dev (pnpm start:dev outside Docker).
# Inside Docker Compose, DB_HOST is automatically overridden to "mysql-superchat" (the service name)
# in docker-compose.yml — the value here does NOT apply when running via Docker.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# phpMyAdmin host port — access at http://localhost:<PMA_HOST_PORT>
PMA_HOST_PORT=8080

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# App
PORT=3000
BACKEND_HOST_PORT=3000

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend build-time variables (Vite embeds these into the JS bundle at build time — not runtime)
# In Docker: passed as build ARGs to the frontend image
# In production: set to your public-facing backend domain (e.g. https://api.yourdomain.com)
# In production: use wss:// for VITE_SOCKET_URL if your backend is behind HTTPS
VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000
