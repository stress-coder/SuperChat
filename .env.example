NODE_VERSION=22
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

PMA_HOST_PORT=8080

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

PORT=3000
BACKEND_HOST_PORT=3000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Same-origin relative paths — nginx proxies /api and /socket.io to the backend.
# Do NOT use http://localhost:3000: that is cross-origin, and the backend sets
# a SameSite=Strict refresh cookie with credentials enabled.
VITE_API_URL=/api
VITE_SOCKET_URL=/
